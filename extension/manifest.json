{
  "manifest_version": 3,
  "name": "Sovra for Chrome",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "description": "Share a page with Sovra Harness and review its browser actions in the side panel.",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "nativeMessaging",
    "sidePanel"
  ],
  "action": {
    "default_title": "Open Sovra for Chrome"
  },
  "background": {
    "service_worker": "worker.js"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "incognito": "not_allowed"
}
